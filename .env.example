# Supabase — https://supabase.com (free tier, no card)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by the ingestion worker. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM generation. Groq is primary, Gemini is the fallback; either alone works.
# Model ids live here because free-tier availability changes without notice.
# Groq — https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# The worker exposes a small embed endpoint so the ask route doesn't load the model itself.
# Set the same token on both sides. Leave WORKER_EMBED_URL unset locally to embed in-process.
WORKER_EMBED_TOKEN=
# WORKER_EMBED_URL=http://localhost:8080
# PORT=8080   (worker only; Railway/Render set this for you)

# Ask endpoint (optional, defaults shown)
# ASK_TOP_K=12
# ASK_RATE_LIMIT=20
# Where transformers.js caches the model. Only matters for the in-process fallback.
# TRANSFORMERS_CACHE=/tmp/transformers

# Worker tuning (all optional, defaults shown)
# WORKER_POLL_MS=3000
# WORKER_INSERT_BATCH=100
# WORKER_EMBED_BATCH=16
# WORKER_STALE_MINUTES=15

# CEILING: all-MiniLM-L6-v2 truncates its input at 256 tokens. Anything past that is stored
# and shown as context but has NO effect on the chunk's vector, so raising CHUNK_TOKENS above
# ~250 silently degrades retrieval instead of improving it. 220 leaves headroom for the
# tokenizer's estimate being off. Raising this requires changing the embedding model too.
# CHUNK_TOKENS=220
# CHUNK_OVERLAP_TOKENS=40
